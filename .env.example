# ── 必填 ──────────────────────────────────────────────────────────────────────
# MySQL 連線字串（可用 Railway / TiDB Cloud / PlanetScale 等免費方案）
DATABASE_URL=mysql://user:password@host:3306/diet_tracker

# 簽署登入 session 用的密鑰（隨機長字串即可，production 必填）
JWT_SECRET=change-me-to-a-long-random-string

# ── AI 拍照辨識（選填，未設定時該功能會提示尚未啟用）───────────────────────────
# 到 https://platform.claude.com 取得 API key
ANTHROPIC_API_KEY=
# 預設 claude-opus-4-8，可改用其他 Claude 模型
# ANTHROPIC_MODEL=claude-opus-4-8

# ── 存取保護（選填）────────────────────────────────────────────────────────────
# 設定後開啟 App 需輸入此密碼；不設定則任何人打開網址都能直接使用
APP_PASSWORD=

# ── Apple Watch / 健康 App 同步（選填）────────────────────────────────────────
# 設定後啟用 POST /api/health/sync，配合 iPhone 捷徑自動匯入運動記錄
HEALTH_SYNC_TOKEN=

# ── 其他 ──────────────────────────────────────────────────────────────────────
# PORT=3000
